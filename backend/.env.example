# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters_long
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_minimum_32_characters_long

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
FROM_EMAIL="Your App Name <your_email@gmail.com>"

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Razorpay Payment Gateway Configuration
# Get these from: https://dashboard.razorpay.com/app/keys
# Test Mode: Use rzp_test_ prefix
# Live Mode: Use rzp_live_ prefix
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Instructions to get Razorpay credentials:
# 1. Sign up at https://dashboard.razorpay.com/signup
# 2. Go to Settings → API Keys
# 3. Generate Test Keys (or Live Keys after KYC)
# 4. Copy Key ID and Key Secret here
# 5. For webhooks: Settings → Webhooks → Create webhook
# 6. Copy Webhook Secret here
